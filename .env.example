APP_NAME="Gunjannagar Khane Pani"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kathmandu
APP_URL=http://localhost:8000

APP_LOCALE=ne
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE=false
APP_MAINTENANCE_STORE=database
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

# Database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=gunjannagar_khanepani
DB_USERNAME=gunjannagar_user
DB_PASSWORD=your_cpanel_database_password

# Admin
ADMIN_EMAIL=admin@gunjannagar.gov.np
ADMIN_PASSWORD=Admin@123

# File Upload
MAX_FILE_SIZE=10240
ALLOWED_IMAGE_TYPES=jpeg,jpg,png,gif,webp
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,xls,xlsx,zip

# Google Maps
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_LAT=27.7172
GOOGLE_MAPS_LNG=85.3240

# Social Links
FACEBOOK_URL=
TWITTER_URL=
YOUTUBE_URL=
INSTAGRAM_URL=
